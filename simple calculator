// a simple calculator

#include<bits/stdc++.h>
using namespace std;
int main(){
    cout<<"Welcome to my Calculator :)\n";
    int op1,op2;
    cout<<"enter two numbers: ";
    cin>>op1>>op2;
    // add
    int sum=op1+op2;
    // sub
    int sub=op1-op2;
    // mul
    int mul=op1*op2;
    // div
    int divi=op1/op2;
    // mod
    int mod=op1%op2;
    int choice;
    cout<<"select the option from(1,2,3,4,5):\n1->add\n2->sub\n3->mul\n4->div\n5->mod:\n\nThe option: ";
    cin>>choice;
    
    switch(choice){
        case 1:
             cout<<sum<<endl;
            break;
        
        case 2:
            cout<<sub<<endl;
            break;
        
        case 3:
            cout<<mul<<endl;
            break;
        
        case 4:
            cout<<divi<<endl;
            // if(op1/0){
            //     cout<<"Error trying to div by zero";
            // }
            break;
        
        case 5:
            cout<<mod<<endl;
            break;
        
        default:
        cout<<"Invalid option"<<endl;
    }
}
